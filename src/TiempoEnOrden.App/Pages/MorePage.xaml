<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TiempoEnOrden.App.Pages.MorePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:TiempoEnOrden.App.Views" Title="Más">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <Label Text="Datos guardados localmente en este dispositivo." Style="{StaticResource Caption}" />
            <Label Text="Más" Style="{StaticResource PageTitle}" />
            <Label Text="Catálogos y configuración de la entrega A." Style="{StaticResource Caption}" />
            <Button Text="Clientes" Command="{Binding OpenClientsCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Servicios" Command="{Binding OpenServicesCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Tiempo personal" Command="{Binding OpenPersonalTimeCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Ajustes" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

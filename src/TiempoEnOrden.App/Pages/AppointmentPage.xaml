<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TiempoEnOrden.App.Pages.AppointmentPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:pages="clr-namespace:TiempoEnOrden.App.Pages" Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnPlatform Android='20,16,20,28', WinUI='32,24,32,32'}" Spacing="18" MaximumWidthRequest="1100" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                <Label Text="Los datos se guardan localmente en este dispositivo." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='1.2*,0.8*'}" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                <Border Style="{StaticResource Card}" Grid.Column="0" Grid.Row="0">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Datos de la cita" Style="{StaticResource SectionTitle}" />
                        <Label Text="Cliente (opcional)" />
                        <Border Style="{StaticResource FieldBorder}"><Picker ItemsSource="{Binding Clients}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedClient}" Title="Sin cliente" /></Border>
                        <Button Text="Crear cliente sin perder este borrador" Command="{Binding OpenClientCreationCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" />
                        <Label Text="Servicio (obligatorio)" />
                        <Border Style="{StaticResource FieldBorder}"><Picker ItemsSource="{Binding Services}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedService}" Title="Selecciona un servicio" /></Border>
                        <Button Text="Crear servicio sin perder este borrador" Command="{Binding OpenServiceCreationCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6"><Label Text="Fecha de inicio" /><Border Style="{StaticResource FieldBorder}"><DatePicker Date="{Binding StartDate}" Format="ddd d MMM yyyy" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Hora de inicio" /><Border Style="{StaticResource FieldBorder}"><TimePicker Time="{Binding StartTime}" Format="HH:mm" /></Border></VerticalStackLayout>
                        </Grid>
                        <Label Text="Notas (opcional)" />
                        <Border Style="{StaticResource FieldBorder}"><Editor Text="{Binding Notes}" Placeholder="Notas ficticias" AutoSize="TextChanges" /></Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="{OnPlatform Android=0, WinUI=1}" Grid.Row="{OnPlatform Android=1, WinUI=0}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Vista previa" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding EndText}" FontFamily="OpenSansSemibold" />
                        <Border Padding="12" BackgroundColor="{StaticResource PreparationSoft}" Stroke="{StaticResource Preparation}" StrokeShape="RoundRectangle 10"><Label Text="{Binding OccupationText}" TextColor="#18282D" /></Border>
                        <Label Text="Zona horaria: Ciudad de México" />
                        <Label Text="Identificador interno: America/Mexico_City · propuesta del dispositivo y confirmada para esta muestra." Style="{StaticResource Caption}" />
                        <Border IsVisible="{Binding HasMessage}" Padding="12" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 10"><Label Text="{Binding Message}" TextColor="{StaticResource Primary}" /></Border>
                        <VerticalStackLayout IsVisible="{Binding HasSuggestions}" Spacing="8" BindableLayout.ItemsSource="{Binding Suggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding DisplayText}" Command="{Binding Source={RelativeSource AncestorType={x:Type pages:AppointmentPage}}, Path=ApplySuggestionCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
                        <Button Text="Cancelar cita" Command="{Binding CancelAppointmentCommand}" IsVisible="{Binding IsEditing}" BackgroundColor="#A33A3A" />
                        <Button Text="Descartar cambios" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButton}" />
                        <Label Text="El guardado comprueba jornada laboral, descanso, tiempo personal y citas activas, incluidos preparación y limpieza." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

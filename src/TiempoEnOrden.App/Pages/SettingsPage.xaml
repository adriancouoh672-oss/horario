<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TiempoEnOrden.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Ajustes">
    <ScrollView>
        <VerticalStackLayout Padding="{OnPlatform Android='20,16,20,28', WinUI='32,24,32,32'}" Spacing="18" MaximumWidthRequest="900" HorizontalOptions="Center">
            <Label Text="Datos guardados localmente en este dispositivo." Style="{StaticResource Caption}" />
            <Label Text="Ajustes" Style="{StaticResource PageTitle}" />
            <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*'}" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="18">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Horario laboral y descanso" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6"><Label Text="Inicio laboral" /><Border Style="{StaticResource FieldBorder}"><TimePicker Time="{Binding WorkStart}" Format="HH:mm" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Fin laboral" /><Border Style="{StaticResource FieldBorder}"><TimePicker Time="{Binding WorkEnd}" Format="HH:mm" /></Border></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6"><Label Text="Inicio descanso" /><Border Style="{StaticResource FieldBorder}"><TimePicker Time="{Binding BreakStart}" Format="HH:mm" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Fin descanso" /><Border Style="{StaticResource FieldBorder}"><TimePicker Time="{Binding BreakEnd}" Format="HH:mm" /></Border></VerticalStackLayout>
                        </Grid>
                        <Label Text="Días laborales" FontFamily="OpenSansSemibold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <HorizontalStackLayout><Switch IsToggled="{Binding Monday}" /><Label Text="Lunes" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1"><Switch IsToggled="{Binding Tuesday}" /><Label Text="Martes" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1"><Switch IsToggled="{Binding Wednesday}" /><Label Text="Miércoles" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1"><Switch IsToggled="{Binding Thursday}" /><Label Text="Jueves" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="2"><Switch IsToggled="{Binding Friday}" /><Label Text="Viernes" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1"><Switch IsToggled="{Binding Saturday}" /><Label Text="Sábado" VerticalOptions="Center" /></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="3"><Switch IsToggled="{Binding Sunday}" /><Label Text="Domingo" VerticalOptions="Center" /></HorizontalStackLayout>
                        </Grid>
                        <Button Text="Guardar horario" Command="{Binding SaveCommand}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="{OnPlatform Android=0, WinUI=1}" Grid.Row="{OnPlatform Android=1, WinUI=0}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Agenda" Style="{StaticResource SectionTitle}" />
                        <Label Text="Semana desde lunes" FontFamily="OpenSansSemibold" />
                        <Label Text="Las citas canceladas están ocultas por defecto y pueden consultarse desde el filtro de Agenda." Style="{StaticResource Caption}" />
                        <Label Text="Zona horaria" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding TimeZoneName}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding TimeZoneId}" Style="{StaticResource Caption}" />
                        <Label Text="Configuración confirmada para este dispositivo; no se deduce para todas las personas de México." Style="{StaticResource Caption}" />
                        <Label Text="Respaldo local" Style="{StaticResource SectionTitle}" />
                        <Label Text="Crea una copia local de la agenda o restaura el respaldo más reciente de este dispositivo." Style="{StaticResource Caption}" />
                        <Button Text="Crear respaldo local" Command="{Binding CreateBackupCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Text="Restaurar último respaldo" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Border IsVisible="{Binding HasMessage}" Padding="12" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 10"><Label Text="{Binding Message}" TextColor="{StaticResource Primary}" /></Border>
            <Label Text="Esta entrega no incluye cuenta, nube, sincronización ni recordatorios coordinados." Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

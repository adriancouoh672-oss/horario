<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TiempoEnOrden.App.Pages.ServicesPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:TiempoEnOrden.App.Views" Title="Servicios">
    <ScrollView>
        <VerticalStackLayout Padding="{OnPlatform Android='20,16,20,28', WinUI='32,24,32,32'}" Spacing="18" MaximumWidthRequest="1100" HorizontalOptions="Fill">
            <views:DemoBannerView />
            <VerticalStackLayout Spacing="4"><Label Text="Servicios" Style="{StaticResource PageTitle}" /><Label Text="Duración, precio y márgenes visibles para citas futuras." Style="{StaticResource Caption}" /></VerticalStackLayout>
            <Border IsVisible="{Binding IsContextMode}" Padding="12" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 10"><Label Text="Creación contextual: el borrador de Nueva cita permanece en memoria." TextColor="{StaticResource Primary}" /></Border>
            <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='1.05*,0.95*'}" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><HorizontalStackLayout Spacing="6"><Switch IsToggled="{Binding ShowArchived}" /><Label Text="Mostrar archivados" VerticalOptions="Center" /></HorizontalStackLayout><VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleServices}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate><Border Padding="12" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 10"><VerticalStackLayout Spacing="3"><Label Text="{Binding Name}" FontFamily="OpenSansSemibold" /><Label Text="{Binding Summary}" /><Label Text="{Binding OccupationSummary}" Style="{StaticResource Caption}" /><Label Text="{Binding StatusText}" Style="{StaticResource Caption}" /></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></Border>
                <Border Grid.Column="{OnPlatform Android=0, WinUI=1}" Grid.Row="{OnPlatform Android=1, WinUI=0}" Style="{StaticResource Card}" VerticalOptions="Start"><VerticalStackLayout Spacing="12"><Label Text="Agregar servicio ficticio" Style="{StaticResource SectionTitle}" /><Label Text="Nombre" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding NewName}" /></Border><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout><Label Text="Duración (min)" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Duration}" Keyboard="Numeric" /></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Precio MXN" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Price}" Keyboard="Numeric" /></Border></VerticalStackLayout></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout><Label Text="Preparación" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Preparation}" Keyboard="Numeric" /></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Limpieza" /><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Cleanup}" Keyboard="Numeric" /></Border></VerticalStackLayout></Grid><Label Text="{Binding Preview}" Style="{StaticResource Caption}" /><Border IsVisible="{Binding HasMessage}" Padding="10" BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 8"><Label Text="{Binding Message}" TextColor="{StaticResource Primary}" /></Border><Button Text="Agregar a la demostración" Command="{Binding AddCommand}" /><Button IsVisible="{Binding IsContextMode}" Text="Volver sin agregar" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" /></VerticalStackLayout></Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

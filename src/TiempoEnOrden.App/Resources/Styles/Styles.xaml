<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource DarkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>
    <Style x:Key="FieldBorder" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource PrimaryHover}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderColor" Value="{StaticResource Preparation}" /><Setter Property="BorderWidth" Value="3" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.55" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="BorderWidth" Value="0" /><Setter Property="Padding" Value="8" /></Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="FontSize" Value="14" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="Padding" Value="12,6" /></Style>
    <Style TargetType="Entry"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /></Style>
    <Style TargetType="Editor"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="96" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /></Style>
    <Style TargetType="Picker"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /><Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /></Style>
    <Style TargetType="DatePicker"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /></Style>
    <Style TargetType="TimePicker"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /></Style>
    <Style TargetType="SearchBar"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /></Style>
    <Style TargetType="Switch"><Setter Property="OnColor" Value="{StaticResource Primary}" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="MinimumWidthRequest" Value="44" /></Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True"><Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" /><Setter Property="Shell.ForegroundColor" Value="{StaticResource Primary}" /><Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" /><Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /><Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" /><Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" /><Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" /></Style>
</ResourceDictionary>
